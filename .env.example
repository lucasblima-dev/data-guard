# Configurações Gerais da Aplicação
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend (React + TypeScript + Vite)
VITE_API_URL=http://localhost:8000/api
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_USER=dataguard
POSTGRES_PASSWORD=dataguard_secret
POSTGRES_DB=dataguard_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dataguard:dataguard_secret@postgres:5432/dataguard_db

# Mensageria e Filas (RabbitMQ)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Armazenamento e Limites Operacionais
STORAGE_PATH=/app/storage
MAX_FILE_SIZE_MB=25

# Controle Global de Ativação (se false, utiliza geração determinística 'rules_only')
LLM_ENABLED=false

# Seleção do Provedor Ativo: 'huggingface' | 'ollama'
LLM_PROVIDER=huggingface

# Opção 1: Hugging Face Serverless Inference API (Nuvem / Sem GPU Local)
HF_TOKEN="SEU_TOKEN_AQUI"
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_API_URL=https://router.huggingface.co/hf-inference/v1/chat/completions

# Opção 2: Ollama em Servidor na Rede Local (LAN / GPU Dedicada)
OLLAMA_BASE_URL=http://192.168.1.100:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=30
