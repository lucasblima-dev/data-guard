# Configurações Gerais da Aplicação
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend (React + TypeScript + Vite)
VITE_API_URL=http://localhost:8000/api
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_USER=dataguard
POSTGRES_PASSWORD=dataguard_secret
POSTGRES_DB=dataguard_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dataguard:dataguard_secret@postgres:5432/dataguard_db

# Mensageria e Filas (RabbitMQ)
# RABBITMQ_USER e RABBITMQ_PASSWORD sao OBRIGATORIOS: o docker compose nao sobe sem eles.
# Dentro do Docker Compose, a RABBITMQ_URL e montada a partir desses dois valores;
# a RABBITMQ_URL abaixo so vale para rodar um servico fora do Docker (mantenha a mesma senha).
MESSAGING_ENABLED=true
RABBITMQ_USER=dataguard
RABBITMQ_PASSWORD=troque_esta_senha
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://dataguard:troque_esta_senha@rabbitmq:5672/
RABBITMQ_EXCHANGE=dataguard.exchange
RABBITMQ_DLX=dataguard.dlx

# Armazenamento e Limites Operacionais
STORAGE_PATH=/app/storage
MAX_FILE_SIZE_MB=25

# Controle Global de Ativação (se false, utiliza geração determinística 'rules_only')
LLM_ENABLED=false

# Seleção do Provedor Ativo: 'huggingface' | 'ollama'
LLM_PROVIDER=huggingface

# Opção 1: Hugging Face Inference Providers Router (Nuvem / Sem GPU Local)
# OBS: uma opção gratuita e talvez melhor, é usar o Google AI Studio com chave de API no modelo gemini-3.5-flash
HF_TOKEN="SEU_TOKEN_AQUI"
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_TIMEOUT_SECONDS=15

# Opção 2: Ollama em Servidor na Rede Local (LAN / GPU Dedicada) ou no próprio Host Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=25
